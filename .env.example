# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public key: either the legacy "anon" JWT or the newer "publishable" key (sb_publishable_…).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…  (alias for the line above)

# Server only. NEVER expose this to the browser or commit it.
# Legacy "service_role" JWT or the newer "secret" key (sb_secret_…).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Clerk (sign-in). Dashboard -> application -> API keys.
# Both are needed; without them the storefront runs but sign-in is disabled.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_…
CLERK_SECRET_KEY=sk_test_…

# ---------------------------------------------------------------------------
# Admin access
# Comma separated email addresses allowed to use /admin. The address must be the
# primary email on the Clerk account; add it to public.admin_users too if you want
# the database-side allow-list.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=youradmin@gmail.com

# Public site origin, used for auth redirects and Razorpay callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Razorpay (optional until you are ready to accept live payments)
# Dashboard -> Account & Settings -> API Keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
